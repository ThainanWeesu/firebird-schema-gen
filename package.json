{
	"name": "firebird-schema-gen",
	"version": "1.0.0",
	"description": "Gera o DDL do Firebird (um .sql por objeto) a partir dos metadados do banco",
	"private": true,
	"packageManager": "bun@1.4.0",
	"scripts": {
		"schema:generate": "bun schema-gen/generate.ts",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write \"schema-gen/**/*.ts\" seenc.firebird.config.ts"
	},
	"dependencies": {
		"@weesurepo/node-firebird": "file:./vendor/node-firebird",
		"dotenv": "^16.4.7"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"prettier": "^3.4.2",
		"typescript": "^5.7.2"
	}
}
