{
	"compilerOptions": {
		"target": "es2019",
		"lib": ["es2019"],
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["schema-gen/**/*.ts", "seenc.firebird.config.ts"]
}
